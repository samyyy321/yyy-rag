BASE_URL_CHAT=https://dashscope.aliyuncs.com/compatible-mode/v1
BASE_URL_RESPONSE=https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
BASE_URL=http://localhost:11434/v1
API_KEY=your-api-key
LLM_MODEL=qwen3.5-flash
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=qwen3-rerank

MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION_NAME=knowledge_docs_v2
MILVUS_DIM=1024
# MinerU 
MINERU_API_URL=http://localhost:8000
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=300

CHUNK_SIZE=512
CHUNK_OVERLAP=64

# TruLens 评测记录与 Dashboard（仅评测层使用）
TRULENS_DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/trulens
TRULENS_DASHBOARD_HOST=127.0.0.1
TRULENS_DASHBOARD_PORT=8501

# FastAPI 生产业务数据库（与 TruLens 评测数据库隔离）
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
MINIO_ENDPOINT=localhost:9000
